#!/bin/bash
# compose/linkedin/start
#
# Runs three things in one container:
#   1. Xvfb + VNC  — so you can watch the Playwright browser live.
#   2. FastAPI admin web server (port 8000) — always up, so the admin panel is
#      reachable whenever you want, independent of the automation daemon.
#   3. The automation daemon (rundaemon) — supervised, restarts if it exits.

set -o pipefail
set -o nounset

# ── Virtual displays ─────────────────────────────────────────────────
# :99 is the fallback display. Each LinkedIn account then gets its own Xvfb
# (:100 + profile id), started on demand by the daemon — see vnc.py — so the
# accounts' browser windows never overlap.
rm -f /tmp/.X99-lock
Xvfb :99 -screen 0 1920x1080x24 &
sleep 1
export DISPLAY=:99
export OPENOUTREACH_PER_ACCOUNT_DISPLAY=true

# ── VNC remote access (browser at :6080, native client at :5900) ─────
# One VNC server for any number of accounts: it follows whichever display the
# control file names, and the admin panel rewrites that file to switch
# accounts. A server per account would need its ports published up front,
# which rules out adding accounts to a running daemon.
VNC_CONTROL_FILE="${OPENOUTREACH_VNC_CONTROL_FILE:-/tmp/openoutreach-vnc-display}"

# An X server holds /tmp/.X<n>-lock while it is up — that is how we know a
# display is real before pointing x11vnc at it (x11vnc exits immediately
# against a display that isn't listening, leaving the viewer with nothing).
vnc_display_ready() {
    [ -e "/tmp/.X${1#:}-lock" ]
}

# With nothing selected, show the first account that actually has a browser.
# The accounts live on :100 and up (see vnc.py); :99 is a bare desktop with
# nothing drawn on it, so defaulting there means staring at an empty screen.
vnc_default_display() {
    local lock number best=""
    for lock in /tmp/.X1[0-9][0-9]-lock; do
        [ -e "$lock" ] || continue
        number="${lock#/tmp/.X}"
        number="${number%-lock}"
        if [ -z "$best" ] || [ "$number" -lt "$best" ]; then
            best="$number"
        fi
    done
    if [ -n "$best" ]; then
        echo ":$best"
    else
        echo ":99"
    fi
}

vnc_follow_selected_display() {
    local current="" wanted vnc_pid=""
    while true; do
        wanted="$(cat "$VNC_CONTROL_FILE" 2>/dev/null || true)"
        [ -z "$wanted" ] && wanted="$(vnc_default_display)"

        if [ "$wanted" != "$current" ] && vnc_display_ready "$wanted"; then
            # Track the pid rather than pkill-ing by pattern: procps isn't
            # guaranteed in the base image, and a silent pkill failure would
            # strand the viewer on the previous account forever.
            [ -n "$vnc_pid" ] && kill "$vnc_pid" 2>/dev/null || true
            x11vnc -display "$wanted" -forever -shared -nopw -rfbport 5900 -quiet &
            vnc_pid=$!
            current="$wanted"
            echo "[start] VNC now showing $wanted"
        fi
        sleep 2
    done
}

if [ "${ENABLE_VNC:-true}" = "true" ]; then
    vnc_follow_selected_display &
    # websockify outlives the x11vnc restarts; open the viewer with
    # ?reconnect=1 so the tab comes back on its own after a switch.
    websockify --web /opt/noVNC 6080 localhost:5900 &
fi

# ── One-time DB setup ────────────────────────────────────────────────
python manage.py migrate --no-input

# Optional: auto-create a Django superuser from env so you can log into the
# admin panel. createsuperuser --noinput reads DJANGO_SUPERUSER_* env vars and
# is a no-op (non-zero, ignored) if the user already exists.
if [ -n "${DJANGO_SUPERUSER_USERNAME:-}" ] && [ -n "${DJANGO_SUPERUSER_PASSWORD:-}" ]; then
    python manage.py createsuperuser --noinput 2>/dev/null \
        && echo "[start] superuser '${DJANGO_SUPERUSER_USERNAME}' created" \
        || echo "[start] superuser '${DJANGO_SUPERUSER_USERNAME}' already exists"
fi

# ── Process supervision ──────────────────────────────────────────────
pids=()

shutdown() {
    echo "[start] shutting down"
    kill "${pids[@]}" 2>/dev/null || true
    wait 2>/dev/null || true
    exit 0
}
trap shutdown SIGTERM SIGINT

# Admin web server — always up.
(
    while true; do
        python -m uvicorn webadmin.main:app --host 0.0.0.0 --port 8000 || true
        echo "[start] admin web server exited — restarting in 3s"
        sleep 3
    done
) &
pids+=($!)

# Automation daemon — restarts if it exits (e.g. crash, or waiting for the
# admin panel / config.json to finish onboarding).
(
    while true; do
        python manage.py rundaemon "$@" || true
        echo "[start] daemon exited — restarting in 10s"
        sleep 10
    done
) &
pids+=($!)

wait
